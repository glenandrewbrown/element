<https://kushview.net/plugins/element>
	ui:ui <https://kushview.net/plugins/element:UI> ;
	a lv2:InstrumentPlugin ;
	doap:name "Element" ;
	doap:description "KV-Element" ;
	lv2:minorVersion 2 ;
	lv2:microVersion 0 ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "Kushview" ;
		foaf:homepage <https://kushview.net> ;
		foaf:mbox <support@kushview.net> ;
	] ;
	doap:release [
		a doap:Version ;
		doap:revision "2.2.0" ;
	] ;
	lv2:optionalFeature
		lv2:hardRTCapable ;
	lv2:extensionData
		state:interface ;
	lv2:requiredFeature
		urid:map ,
		opts:options ,
		bufs:boundedBlockLength ;
	pg:mainInput plug:input_group_1 ;
	pg:mainOutput plug:output_group_1 ;
