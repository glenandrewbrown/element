@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://kushview.net/plugins/element>
	a lv2:Plugin ;
	lv2:binary <libKV-Element.so> ;
	rdfs:seeAlso <dsp.ttl> .

<https://kushview.net/plugins/element:UI>
	a ui:CocoaUI ;
	lv2:binary <libKV-Element.so> ;
	rdfs:seeAlso <ui.ttl> .

<https://kushview.net/plugins/element:preset1>
	a pset:Preset ;
	lv2:appliesTo <https://kushview.net/plugins/element> ;
	rdfs:label "Default" ;
	state:state [ <https://kushview.net/plugins/element:Program> "0"^^xsd:int ; ] .

