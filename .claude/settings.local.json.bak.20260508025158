{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -z \"$f\" ] && exit 0; case \"$f\" in */engine/*|*/nodes/*) matches=$(grep -nE '(\\bnew\\b |\\bdelete\\b |\\bmalloc\\b|\\bfree\\b|\\bmutex\\b|\\block_guard\\b|\\bunique_lock\\b|juce::CriticalSection|juce::SpinLock)' \"$f\" 2>/dev/null | grep -v '//.*no-rt-check' | grep -v 'prepareToRender\\|releaseResources\\|setState\\|getState' | head -5); if [ -n \"$matches\" ]; then echo \"{\\\"decision\\\": \\\"block\\\", \\\"reason\\\": \\\"RT-SAFETY: Potential real-time unsafe code in audio path. Found:\\n${matches}\\nUse pre-allocated buffers/atomics, or add //no-rt-check comment if intentional.\\\"}\"; fi;; esac; } 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -z \"$f\" ] && exit 0; case \"$f\" in */test/*) if [ -d build-merged ]; then cd build-merged && ctest --output-on-failure --timeout 30 -j4 2>&1 | tail -15; fi;; esac; } 2>/dev/null || true",
            "timeout": 60000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
