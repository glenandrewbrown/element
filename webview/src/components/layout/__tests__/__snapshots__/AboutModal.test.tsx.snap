exports[`<AboutModal /> > matches the checking snapshot 1`] = `
<div
  aria-label="About Element"
  aria-modal="true"
  class="fixed inset-0 z-[210] flex items-center justify-center bg-black/55"
  role="dialog"
>
  <div
    class="w-[min(420px,92vw)] rounded-lg bg-surface shadow-[8px_8px_24px_rgba(0,0,0,0.5),-2px_-2px_8px_rgba(255,255,255,0.04)] border border-white/5 p-6 space-y-4"
  >
