+// Recovery-then-second-crash: a worker loads OK once (which RESETS the host's
+// restart budget), then a LATER load crashes. Because the first success reset
+// the budget, the single later crash must NOT immediately exhaust the cap — the
+// host must recover (reload OK) rather than fall to Error. This exercises the
+// restartAttempts=0-on-PluginLoaded reset that the every-load CrashOnLoad test
+// above cannot (it never loads OK, so the budget is never reset).
+//
+// Mechanism: CrashOnNthLoadPluginFormat loads a working TestEcho instance until
+// the Nth createPluginInstance (counted across worker relaunches via a /tmp
+// file), then ::abort()s that one. With N=2:
+//   instantiation #1 -> OK   (PluginLoaded; restartAttempts reset to 0)
+//   we force a reload -> instantiation #2 -> abort -> crash-recovery (1 attempt)
+//   recovery reload   -> instantiation #3 -> OK   (sandboxRestarted; reset to 0)
+BOOST_AUTO_TEST_CASE (LoadsOkThenLaterLoadCrashRecoversWithoutGivingUp)
+{
+    auto* ctx = element::test::context();
+    BOOST_REQUIRE (ctx != nullptr);
+
+    const pid_t hostPid = ::getpid();
+
+    // Fresh shared counter + crash on the 2nd instantiation. The worker is a
+    // child process that inherits this env at spawn.
+    juce::File (kCrashOnNthLoadCounterPath).deleteFile();
+    ::setenv (kCrashOnNthLoadEnvVar, "2", 1);
+    struct EnvGuard
+    {
+        ~EnvGuard()
+        {
+            ::unsetenv (kCrashOnNthLoadEnvVar);
+            juce::File (kCrashOnNthLoadCounterPath).deleteFile();
+        }
+    } envGuard;
+
+    SandboxHost host (ctx->plugins());
+    CrashOnLoadObserver observer;
+    host.addListener (&observer);
+
+    BOOST_REQUIRE_MESSAGE (host.launch(), "SandboxHost::launch failed");
+    BOOST_REQUIRE (host.getState() == SandboxHost::State::Ready);
+
+    pumpUntil ([] { return false; }, std::chrono::milliseconds (300));
+
+    // First load: instantiation #1 -> OK.
+    host.loadPlugin (makeCrashOnNthLoadDescription());
+    const bool firstLoaded = pumpUntil (
+        [&] { return host.getState() == SandboxHost::State::Active
+                  && observer.loadCount.load() >= 1; },
+        std::chrono::milliseconds (8000));
+    BOOST_REQUIRE_MESSAGE (firstLoaded,
+                           "first (OK) load never reached Active (state="
+                           << (int) host.getState()
+                           << " loadCount=" << observer.loadCount.load() << ")");
+
+    // Force a second load -> instantiation #2 -> the worker ::abort()s mid-load.
+    // This drives the host's crash-recovery path; recovery reload is #3 -> OK.
+    const int loadsBeforeCrash = observer.loadCount.load();
+    host.loadPlugin (makeCrashOnNthLoadDescription());
+
+    // The host must RECOVER: a second successful load arrives and state is Active
+    // again. (loadCount climbs to >= loadsBeforeCrash + 1 from the recovery load.)
+    const bool recovered = pumpUntil (
+        [&] { return host.getState() == SandboxHost::State::Active
+                  && observer.loadCount.load() > loadsBeforeCrash; },
+        std::chrono::milliseconds (12000));
+
+    const bool hostAlive = (::kill (hostPid, 0) == 0);
+    BOOST_CHECK_MESSAGE (hostAlive, "host process died during recovery-then-crash");
+
+    BOOST_CHECK_MESSAGE (recovered,
+                         "host did not recover after a post-success load-crash (state="
+                         << (int) host.getState()
+                         << " loadCount=" << observer.loadCount.load()
+                         << " crashes=" << observer.crashCount.load()
+                         << " restarts=" << observer.restartCount.load() << ")");
+
+    // The single post-success crash must NOT have driven the host to permanent
+    // Error — the budget was reset by the first OK load.
+    BOOST_CHECK_MESSAGE (host.getState() != SandboxHost::State::Error,
+                         "host fell to permanent Error after one post-success crash — "
+                         "restart budget was not reset by the first successful load");
+
+    // The crash + recovery should have surfaced exactly the crash/restart signals.
+    BOOST_CHECK_GE (observer.crashCount.load(), 1);
+    BOOST_CHECK_GE (observer.restartCount.load(), 1);
+
+    BOOST_TEST_MESSAGE ("recovery-then-crash: state=" << (int) host.getState()
+                        << " loads=" << observer.loadCount.load()
+                        << " crashes=" << observer.crashCount.load()
+                        << " restarts=" << observer.restartCount.load());
+
+    host.removeListener (&observer);
+    host.shutdown();
+
+    BOOST_CHECK (::kill (hostPid, 0) == 0);
+}
+
+// Persistent spawn-failure: a worker that load-crashes once and can then NEVER
+// be relaunched (every spawn fails) must still terminate in Error within the
+// restart budget — never re-arm restartRequested forever (the A2 bug). Uses the
+// SpawnFailingSandboxHost stub: the first spawn is real (so we reach Ready and
+// can trigger a load-crash), every relaunch after that returns false.
+BOOST_AUTO_TEST_CASE (PersistentSpawnFailureTerminatesInErrorBounded)
+{
+    auto* ctx = element::test::context();
+    BOOST_REQUIRE (ctx != nullptr);
+
+    const pid_t hostPid = ::getpid();
+
+    SpawnFailingSandboxHost host (ctx->plugins());
+    CrashOnLoadObserver observer;
+    host.addListener (&observer);
+
+    BOOST_REQUIRE_MESSAGE (host.launch(), "SandboxHost::launch failed (first spawn)");
+    BOOST_REQUIRE (host.getState() == SandboxHost::State::Ready);
+
+    pumpUntil ([] { return false; }, std::chrono::milliseconds (300));
+
+    const auto t0 = std::chrono::steady_clock::now();
+
+    // Trigger a load-crash on the (real) first worker. The worker dies; the host
+    // arms a restart, but every relaunch now FAILS, so the spawn-failure budget
+    // path must drive it to Error.
+    host.loadPlugin (makeCrashOnLoadDescription());
+
+    constexpr int kSpawnFailPumpCeilingMs = 14000;
+    constexpr int kSpawnFailBoundMs = 12000;
+    const bool settledError = pumpUntil (
+        [&] { return host.getState() == SandboxHost::State::Error; },
+        std::chrono::milliseconds (kSpawnFailPumpCeilingMs));
+
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds> (
+                             std::chrono::steady_clock::now() - t0);
+
+    const bool hostAlive = (::kill (hostPid, 0) == 0);
+    BOOST_CHECK_MESSAGE (hostAlive, "host died during persistent spawn-failure");
+
+    BOOST_CHECK_MESSAGE (settledError,
+                         "host did not reach Error on persistent spawn-failure (state="
+                         << (int) host.getState()
+                         << " elapsed=" << elapsed.count() << " ms) — spawn-failure "
+                         "path likely re-arms restartRequested forever (A2 bug)");
+
+    BOOST_CHECK_MESSAGE (elapsed.count() < kSpawnFailBoundMs,
+                         "spawn-failure give-up took " << elapsed.count()
+                         << " ms (>= " << kSpawnFailBoundMs << " ms) — not bounded");
+
+    // Crash surfaced; relaunches were attempted; no successful (re)load ever.
+    BOOST_CHECK_GE (observer.crashCount.load(), 1);
+    BOOST_CHECK_GE (host.spawnCalls.load(), 2);   // first real + >=1 failing relaunch
+    BOOST_CHECK_EQUAL (observer.loadCount.load(), 0);
+
+    BOOST_TEST_MESSAGE ("spawn-failure: state=" << (int) host.getState()
+                        << " elapsed_ms=" << elapsed.count()
+                        << " spawnCalls=" << host.spawnCalls.load()
+                        << " crashes=" << observer.crashCount.load());
+
+    host.removeListener (&observer);
+    host.shutdown();
+
+    BOOST_CHECK (::kill (hostPid, 0) == 0);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
