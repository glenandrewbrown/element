 namespace element {
@@ -136,4 +138,156 @@ private:
     JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (CrashOnLoadPluginFormat)
 };
 
+//==============================================================================
+// Crash-on-Nth-load: loads OK until the Nth instantiation, then ::abort()s.
+//
+// The CrashOnLoad format above crashes on EVERY load, so it can only prove the
+// give-up path. To prove RECOVERY-then-second-crash — a worker that loads OK
+// once (which RESETS the host's restart budget) and only crashes on a LATER
+// load — we need a counter that survives worker RELAUNCH (each relaunch is a
+// fresh process, so an in-process static would reset every time). We therefore
+// persist the instantiation count in a /tmp file keyed by the test, shared by
+// every worker process. The host-side test truncates it to 0 before the run and
+// sets the crash threshold via an env var the worker reads.
+
+/** Sentinel identifier for the crash-on-Nth-load format. */
+inline constexpr const char* kCrashOnNthLoadIdentifier = "ElementTestCrashOnNthLoad";
+
+/** Sentinel format-name string. Distinct from the other test formats. */
+inline constexpr const char* kCrashOnNthLoadFormatName = "TestCrashNth";
+
+/** Unique-id for the crash-on-Nth-load plugin. */
+inline constexpr int kCrashOnNthLoadUniqueId = 0xC7A50001;
+
+/** Path of the cross-process instantiation counter (shared by all workers). */
+inline constexpr const char* kCrashOnNthLoadCounterPath = "/tmp/element-test-crash-nth-counter";
+
+/** Env var (read by the worker) carrying the 1-based instantiation index that
+    must crash. e.g. "2" => the 2nd createPluginInstance across all workers
+    ::abort()s; all others load OK. */
+inline constexpr const char* kCrashOnNthLoadEnvVar = "EL_TEST_CRASH_ON_NTH_LOAD";
+
+//==============================================================================
+/** AudioPluginFormat that loads a working TestEcho instance until the Nth call to
+    createPluginInstance (across worker process relaunches, tracked via a /tmp
+    counter), then hard-crashes that one instantiation. Registered in
+    SandboxWorker::initializeWorker() only under EL_SANDBOX_INCLUDE_TEST_FORMATS. */
+class CrashOnNthLoadPluginFormat : public juce::AudioPluginFormat
+{
+public:
+    CrashOnNthLoadPluginFormat() = default;
+    ~CrashOnNthLoadPluginFormat() override = default;
+
+    //==========================================================================
+    juce::String getName() const override { return kCrashOnNthLoadFormatName; }
+
+    bool fileMightContainThisPluginType (const juce::String& fileOrIdentifier) override
+    {
+        return fileOrIdentifier == kCrashOnNthLoadIdentifier;
+    }
+
+    void findAllTypesForFile (juce::OwnedArray<juce::PluginDescription>& results,
+                               const juce::String& fileOrIdentifier) override
+    {
+        if (fileOrIdentifier != kCrashOnNthLoadIdentifier)
+            return;
+        results.add (new juce::PluginDescription (makeDescription()));
+    }
+
+    juce::String getNameOfPluginFromIdentifier (const juce::String& fileOrIdentifier) override
+    {
+        return fileOrIdentifier == kCrashOnNthLoadIdentifier
+                   ? juce::String (kCrashOnNthLoadIdentifier)
+                   : juce::String();
+    }
+
+    bool pluginNeedsRescanning (const juce::PluginDescription&) override { return false; }
+    bool doesPluginStillExist (const juce::PluginDescription&) override { return true; }
+    bool canScanForPlugins() const override { return false; }
+    bool isTrivialToScan() const override { return true; }
+
+    juce::StringArray searchPathsForPlugins (const juce::FileSearchPath&,
+                                              bool, bool) override { return {}; }
+
+    juce::FileSearchPath getDefaultLocationsToSearch() override { return {}; }
+
+    bool requiresUnblockedMessageThreadDuringCreation (const juce::PluginDescription&) const override
+    {
+        return false;
+    }
+
+protected:
+    //==========================================================================
+    void createPluginInstance (const juce::PluginDescription& desc,
+                                double initialSampleRate,
+                                int initialBufferSize,
+                                PluginCreationCallback callback) override
+    {
+        if (desc.fileOrIdentifier != kCrashOnNthLoadIdentifier)
+        {
+            callback (nullptr,
+                      "CrashOnNthLoadPluginFormat: identifier '"
+                          + desc.fileOrIdentifier + "' is not '"
+                          + kCrashOnNthLoadIdentifier + "'");
+            return;
+        }
+
+        const int crashOn = juce::SystemStats::getEnvironmentVariable (kCrashOnNthLoadEnvVar, "0")
+                                .getIntValue();
+        const int count = bumpInstantiationCounter();
+        juce::Logger::writeToLog ("[CrashOnNthLoad] instantiation #" + juce::String (count)
+                                   + " crashOn=" + juce::String (crashOn));
+
+        if (crashOn > 0 && count == crashOn)
+        {
+            // This is the designated crashing load: die before returning, exactly
+            // like a plugin that segfaults in its factory on a later open.
+            std::fflush (nullptr);
+            ::abort();
+        }
+
+        // Otherwise load a real, working instance so the host sees PluginLoaded.
+        auto instance = std::make_unique<TestEchoPluginInstance> (initialSampleRate,
+                                                                  initialBufferSize);
+        callback (std::move (instance), juce::String());
+    }
+
+private:
+    //==========================================================================
+    static juce::PluginDescription makeDescription()
+    {
+        juce::PluginDescription desc;
+        desc.name              = kCrashOnNthLoadIdentifier;
+        desc.descriptiveName   = "Element Test Crash-On-Nth-Load";
+        desc.pluginFormatName  = kCrashOnNthLoadFormatName;
+        desc.fileOrIdentifier  = kCrashOnNthLoadIdentifier;
+        desc.category          = "Effect";
+        desc.manufacturerName  = "Element";
+        desc.version           = "1.0";
+        desc.uniqueId          = kCrashOnNthLoadUniqueId;
+        desc.deprecatedUid     = kCrashOnNthLoadUniqueId;
+        desc.numInputChannels  = 0;
+        desc.numOutputChannels = 2;
+        desc.isInstrument      = false;
+        return desc;
+    }
+
+    /** Read-modify-write the shared /tmp counter; returns the new (1-based) value.
+        Worker processes are serialised by the host (one load in flight at a time),
+        so a plain read/append-rewrite is race-free enough for this single-host
+        test. */
+    static int bumpInstantiationCounter()
+    {
+        juce::File counter (kCrashOnNthLoadCounterPath);
+        const int previous = counter.existsAsFile()
+                                 ? counter.loadFileAsString().trim().getIntValue()
+                                 : 0;
+        const int next = previous + 1;
+        counter.replaceWithText (juce::String (next));
+        return next;
+    }
+
+    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR (CrashOnNthLoadPluginFormat)
+};
+
 } // namespace element
