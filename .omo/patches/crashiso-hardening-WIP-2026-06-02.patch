diff --git a/src/engine/test_crash_plugin.hpp b/src/engine/test_crash_plugin.hpp
index a695c2f3..692c1c43 100644
--- a/src/engine/test_crash_plugin.hpp
+++ b/src/engine/test_crash_plugin.hpp
@@ -30,6 +30,8 @@
 
 #include <element/juce.hpp>
 
